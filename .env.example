# Aleo deployment secrets (only needed for local Leo CLI operations)
ALEO_PRIVATE_KEY=your_private_key_here
PRIVATE_KEY=your_private_key_here
ALEO_VIEW_KEY=your_view_key_here
ALEO_ADDRESS=your_aleo_address_here

# Network and API endpoint configuration
ALEO_NETWORK=testnet
ALEO_EXPLORER_API=https://api.explorer.provable.com/v1

# Frontend (Next.js) runtime - REQUIRED for Vercel deployment
NEXT_PUBLIC_ALEO_NETWORK=testnetbeta
NEXT_PUBLIC_ALEO_ADDRESS=your_aleo_address_here
NEXT_PUBLIC_PROGRAM_ID=zk_invoice_new.aleo